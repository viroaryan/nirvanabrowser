diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/NirvanaAddonPolicy.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/NirvanaAddonPolicy.kt
new file mode 100644
index 000000000000..bdfe7faecbff
--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/NirvanaAddonPolicy.kt
@@ -0,0 +1,73 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.addons
+
+import android.content.Context
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import java.io.File
+import mozilla.components.concept.engine.webextension.InstallationMethod
+import mozilla.components.concept.engine.webextension.WebExtension
+import mozilla.components.feature.addons.Addon
+import mozilla.components.feature.addons.AddonManager
+import mozilla.components.feature.addons.update.AddonUpdater
+
+object NirvanaAddonPolicy {
+    const val UBLOCK_ID = "uBlock0@raymondhill.net"
+    private const val UBLOCK_ASSET_PATH = "extensions/ublock_origin.xpi"
+
+    fun enforce(
+        context: Context,
+        addonManager: AddonManager,
+        addonUpdater: AddonUpdater,
+        installedExtensions: List<WebExtension>,
+        scope: CoroutineScope,
+    ) {
+        if (installedExtensions.none { it.id == UBLOCK_ID }) {
+            addonManager.installAddon(
+                url = copyBundledUblock(context),
+                installationMethod = InstallationMethod.MANAGER,
+                onSuccess = { addon ->
+                    enforceEnabled(addonManager, addon)
+                    addonUpdater.registerForFutureUpdates(UBLOCK_ID)
+                },
+            )
+            return
+        }
+
+        addonUpdater.registerForFutureUpdates(UBLOCK_ID)
+
+        scope.launch {
+            addonManager.getAddonByID(UBLOCK_ID)?.let { addon ->
+                enforceEnabled(addonManager, addon)
+            }
+        }
+    }
+
+    private fun copyBundledUblock(context: Context): String {
+        val target = File(context.cacheDir, "ublock_origin.xpi")
+        context.assets.open(UBLOCK_ASSET_PATH).use { input ->
+            target.outputStream().use { output -> input.copyTo(output) }
+        }
+        return "file://" + target.absolutePath
+    }
+
+    private fun enforceEnabled(addonManager: AddonManager, addon: Addon) {
+        fun allowPrivateBrowsing(enabledAddon: Addon) {
+            if (!enabledAddon.isAllowedInPrivateBrowsing()) {
+                addonManager.setAddonAllowedInPrivateBrowsing(enabledAddon, allowed = true)
+            }
+        }
+
+        if (addon.isEnabled()) {
+            allowPrivateBrowsing(addon)
+        } else {
+            addonManager.enableAddon(
+                addon,
+                onSuccess = ::allowPrivateBrowsing,
+            )
+        }
+    }
+}
